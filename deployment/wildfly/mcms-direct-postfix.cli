# Run with an authenticated WildFly CLI after Postfix is listening on 127.0.0.1:25.
# This replaces the Brevo SMTP destination with the local Postfix MTA.
/socket-binding-group=standard-sockets/remote-destination-outbound-socket-binding=mail-smtp:write-attribute(name=host,value=127.0.0.1)
/socket-binding-group=standard-sockets/remote-destination-outbound-socket-binding=mail-smtp:write-attribute(name=port,value=25)
/subsystem=mail/mail-session=default/server=smtp:undefine-attribute(name=username)
/subsystem=mail/mail-session=default/server=smtp:undefine-attribute(name=password)
/subsystem=mail/mail-session=default/server=smtp:write-attribute(name=tls,value=false)
